rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null && request.auth.token.email_verified == true; }
  function groupPath(g) { return /databases/$(database)/documents/groups/$(g); }
  function userPath(u) { return /databases/$(database)/documents/users/$(u); }
  function invitePath(c) { return /databases/$(database)/documents/invites/$(c); }
  function statePath(g) { return /databases/$(database)/documents/groups/$(g)/pets/drac; }
  function eventPath(g,e) { return /databases/$(database)/documents/groups/$(g)/events/$(e); }
  function slotPath(g,s) { return /databases/$(database)/documents/groups/$(g)/slots/$(s); }
  function member(g) { return signed() && request.auth.uid in get(groupPath(g)).data.members; }
  function importing(g) { return member(g) && get(groupPath(g)).data.owner == request.auth.uid && get(groupPath(g)).data.migrationOpen == true; }
  function live(g) { return member(g) && get(groupPath(g)).data.migrationOpen == false; }
  function author(e) {
   return e.actor.keys().hasOnly(['uid','name']) && e.actor.uid == request.auth.uid &&
    e.actor.name == request.auth.token.get('name', request.auth.token.get('email','Usuário')) && e.serverAt == request.time;
  }
  function validState(s) {
   return s.keys().hasOnly(['drac','tratamentos','medicamentos','horarios_medicamentos','medicationsById','version','nextId','lastEventId']) &&
    s.drac is list && s.drac.size() <= 1 && s.tratamentos is list && s.tratamentos.size() <= 500 &&
    s.medicamentos is list && s.medicamentos.size() <= 500 && s.horarios_medicamentos is list && s.horarios_medicamentos.size() <= 500 &&
    s.medicationsById is map && s.medicationsById.size() == s.medicamentos.size() && s.version is int && s.version > 0 && s.lastEventId is string;
  }
  function validSlot(s,k) {
   return s.keys().hasOnly(['medicamento_id','data','horario','administrado','administrado_em','actorUid','actorName','medicationName','dose','unidade','version','lastEventId','serverAt']) &&
    s.medicamento_id is int && s.medicamento_id > 0 && s.data is string && s.data.matches('[0-9]{2}/[0-9]{2}/[0-9]{4}') &&
    s.horario is string && s.horario.matches('([01][0-9]|2[0-3]):[0-5][0-9]') &&
    k == string(s.medicamento_id) + '_' + s.data.split('/')[0] + '-' + s.data.split('/')[1] + '-' + s.data.split('/')[2] + '_' + s.horario.split(':')[0] + '-' + s.horario.split(':')[1] &&
    s.administrado in [0,1] && s.version is int && s.version > 0 && s.serverAt == request.time;
  }
  function oldSlot(g,k) { return exists(slotPath(g,k)) ? get(slotPath(g,k)).data : null; }
  function matchesOldSlot(g,k,before) { return exists(slotPath(g,k)) ? before == get(slotPath(g,k)).data : before == null; }
  function slotVersion(g,k) { return exists(slotPath(g,k)) ? get(slotPath(g,k)).data.version : 0; }
  function legacy(g,e,k) {
   return importing(g) && e.type == 'legacy' && e.importedBy == request.auth.uid && e.actor.uid == null &&
    e.actor.name == 'Registro local anterior — responsável desconhecido' && e.serverAt == request.time &&
    e.after.actorUid == null && e.after.actorName == e.actor.name && e.after.dose == 'não registrada no histórico antigo' &&
    e.after.version == slotVersion(g,k)+1 && matchesOldSlot(g,k,e.before);
  }
  function dose(g,e,k) {
   let s = get(statePath(g)).data;
   let m = s.medicationsById[string(e.after.medicamento_id)];
   return live(g) && author(e) && e.type in ['administer','undo'] && e.medicationVersion == s.version &&
    e.after.actorUid == request.auth.uid && e.after.actorName == e.actor.name && e.after.administrado_em == e.clientAt && e.clientAt is string &&
    e.after.medicationName == m.nome && e.after.dose == m.dose && e.after.unidade == (m.get('unidade',null) == null ? '' : m.unidade) &&
    e.after.administrado == (e.type == 'administer' ? 1 : 0) && e.after.version == slotVersion(g,k)+1 && matchesOldSlot(g,k,e.before) &&
    (e.type != 'administer' || e.before == null || e.before.administrado != 1 || e.confirmedVersion == e.before.version);
  }
  function slotWrite(g,k,s) {
   let e = getAfter(eventPath(g,s.lastEventId)).data;
   return validSlot(s,k) && !exists(eventPath(g,s.lastEventId)) && e.slotId == k && e.after == s &&
    ((e.type == 'legacy' && e.writesSlot == true && legacy(g,e,k)) || dose(g,e,k));
  }
  match /users/{uid} {
   allow get: if signed() && request.auth.uid == uid;
   allow list, update, delete: if false;
   allow create: if signed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['groupId','name','inviteCode']) &&
    request.resource.data.name is string && request.resource.data.name.size() <= 200 &&
    uid in getAfter(groupPath(request.resource.data.groupId)).data.members;
  }
  match /groups/{g} {
   allow read: if member(g);
   allow delete: if false;
   allow create: if signed() && request.resource.data.keys().hasOnly(['owner','members','migrationOpen','inviteCode','createdAt']) &&
    request.resource.data.owner == request.auth.uid && request.resource.data.members == [request.auth.uid] &&
    request.resource.data.migrationOpen == true && request.resource.data.inviteCode == '' && request.resource.data.createdAt == request.time &&
    !exists(userPath(request.auth.uid)) && getAfter(userPath(request.auth.uid)).data.groupId == g && getAfter(statePath(g)).data.version == 1;
   allow update: if signed() && (
    (resource.data.owner == request.auth.uid &&
      ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['migrationOpen']) && resource.data.migrationOpen == true && request.resource.data.migrationOpen == false) ||
       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteCode']) && resource.data.migrationOpen == false &&
        getAfter(invitePath(request.resource.data.inviteCode)).data.groupId == g && getAfter(invitePath(request.resource.data.inviteCode)).data.owner == request.auth.uid))) ||
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) && resource.data.members.size() < 2 &&
     !(request.auth.uid in resource.data.members) && request.resource.data.members.size() == resource.data.members.size()+1 &&
     request.resource.data.members.hasAll(resource.data.members) && request.auth.uid in request.resource.data.members &&
     resource.data.migrationOpen == false && !exists(userPath(request.auth.uid)) &&
     get(invitePath(resource.data.inviteCode)).data.groupId == g && get(invitePath(resource.data.inviteCode)).data.expiresAt > request.time &&
     !existsAfter(invitePath(resource.data.inviteCode)) && getAfter(userPath(request.auth.uid)).data.groupId == g &&
     getAfter(userPath(request.auth.uid)).data.inviteCode == resource.data.inviteCode)
   );
   match /pets/{pet} {
    allow read: if member(g);
    allow delete: if false;
    allow create: if signed() && pet == 'drac' && validState(request.resource.data) && request.resource.data.version == 1 && request.resource.data.lastEventId == 'initial' &&
     getAfter(groupPath(g)).data.owner == request.auth.uid && getAfter(groupPath(g)).data.migrationOpen == true && !exists(groupPath(g));
    allow update: if pet == 'drac' && live(g) && validState(request.resource.data) && request.resource.data.version == resource.data.version+1 &&
     !exists(eventPath(g,request.resource.data.lastEventId)) &&
     author(getAfter(eventPath(g,request.resource.data.lastEventId)).data) &&
     getAfter(eventPath(g,request.resource.data.lastEventId)).data.type in ['save','delete'] &&
     getAfter(eventPath(g,request.resource.data.lastEventId)).data.before == resource.data &&
     getAfter(eventPath(g,request.resource.data.lastEventId)).data.after == request.resource.data;
   }
   match /slots/{slot} {
    allow read: if member(g);
    allow create, update: if signed() && slotWrite(g,slot,request.resource.data);
    allow delete: if false;
   }
   match /events/{event} {
    allow read: if member(g);
    allow update, delete: if false;
    allow create: if signed() && (
     (request.resource.data.type in ['save','delete'] && live(g) && author(request.resource.data) &&
      request.resource.data.before == get(statePath(g)).data && request.resource.data.after == getAfter(statePath(g)).data &&
      request.resource.data.after.version == request.resource.data.before.version+1 && request.resource.data.after.lastEventId == event) ||
     (request.resource.data.type in ['administer','undo'] && dose(g,request.resource.data,request.resource.data.slotId) &&
      request.resource.data.after == getAfter(slotPath(g,request.resource.data.slotId)).data && request.resource.data.after.lastEventId == event &&
      validSlot(request.resource.data.after,request.resource.data.slotId)) ||
     (event.matches('legacy-[0-9]+') && legacy(g,request.resource.data,request.resource.data.slotId) &&
      validSlot(request.resource.data.after,request.resource.data.slotId) && request.resource.data.after.lastEventId == event &&
      (request.resource.data.writesSlot == false || request.resource.data.after == getAfter(slotPath(g,request.resource.data.slotId)).data))
    );
   }
  }
  match /invites/{code} {
   allow get: if signed();
   allow list, update: if false;
   allow create: if signed() && code.matches('[a-f0-9]{48}') && request.resource.data.keys().hasOnly(['groupId','owner','expiresAt']) &&
    request.resource.data.owner == request.auth.uid && get(groupPath(request.resource.data.groupId)).data.owner == request.auth.uid &&
    get(groupPath(request.resource.data.groupId)).data.migrationOpen == false && getAfter(groupPath(request.resource.data.groupId)).data.inviteCode == code &&
    request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(24,'h');
   allow delete: if signed() && (resource.data.owner == request.auth.uid ||
    (resource.data.expiresAt > request.time && get(groupPath(resource.data.groupId)).data.inviteCode == code &&
     !(request.auth.uid in get(groupPath(resource.data.groupId)).data.members) && request.auth.uid in getAfter(groupPath(resource.data.groupId)).data.members &&
     getAfter(userPath(request.auth.uid)).data.inviteCode == code));
  }
  match /{document=**} { allow read, write: if false; }
 }
}

